#!/bin/sh /etc/rc.common
# procd service for kidproxy. Respawned if it dies; a dead proxy means the kids
# network has no web access (fail-closed by design).

USE_PROCD=1
START=96
STOP=10

start_service() {
	[ -x /usr/bin/kidproxy ] || {
		logger -t kidproxy "binary missing; not starting"
		return 1
	}
	procd_open_instance
	procd_set_param command /usr/bin/kidproxy run --config /etc/kidproxy/config.yaml
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/kidproxy/config.yaml
	procd_set_param limits core="0 0"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger kidproxy
}

# /etc/config/kids_schedule — per-kid bedtimes and daily time limits for the
# kids network. Managed from the admin dashboard ("Bedtimes & Time Limits");
# enforced by /usr/bin/kids-schedule.sh (cron, every minute). See
# docs/reference/kids-schedules.md.
#
# Kids are created by the dashboard as anonymous sections, e.g.:
#
#   config kid
#   	option name 'Alex'
#   	option enabled '1'
#   	list mac 'aa:bb:cc:dd:ee:ff'
#   	list block 'sun mon tue wed thu 21:00-07:00'
#   	list limit 'video 60'
#   	list limit 'social 0'
#
# Categories below were seeded by `kids-schedule.sh install` (pulled from the Pi);
# edit their `domain` lists to tune what counts.

config category 'video'
	option label 'Video'
	option min_bytes '50000'
	list domain 'googlevideo.com'
	list domain 'nflxvideo.net'
	list domain 'netflix.com'
	list domain 'twitch.tv'
	list domain 'ttvnw.net'
	list domain 'jtvnw.net'
	list domain 'disneyplus.com'
	list domain 'dssott.com'
	list domain 'bamgrid.com'
	list domain 'hulu.com'
	list domain 'hulustream.com'
	list domain 'vimeo.com'
	list domain 'vimeocdn.com'
	list domain 'aiv-cdn.net'
	list domain 'primevideo.com'


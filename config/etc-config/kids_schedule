# /etc/config/kids_schedule — per-kid bedtimes, daily time limits and usage
# history for the kids network. Managed from the admin dashboard ("Bedtimes &
# Time Limits"); enforced by /usr/bin/kids-schedule.sh (cron, every minute).
# See docs/reference/kids-schedules.md.
#
# Kid sections (names, device MACs, bedtimes, limits) live only on the Pi and
# are deliberately NOT kept in this repo. The dashboard creates them, e.g.:
#
#   config kid
#   	option name 'Alex'
#   	option enabled '1'
#   	list mac 'aa:bb:cc:dd:ee:ff'
#   	list block 'sun mon tue wed thu 21:00-07:00'
#   	list limit 'video 60'
#   	list limit 'social 0'
#
# Categories and services below were seeded by `kids-schedule.sh install`
# (pulled from the Pi); edit the services' `domain` lists to tune what counts.

config category 'video'
	option label 'Video'
	option min_bytes '50000'

config category 'social'
	option label 'Social media'
	option min_bytes '20000'

config category 'games'
	option label 'Games'
	option min_bytes '20000'

config service 'youtube'
	option label 'YouTube'
	option category 'video'
	list domain 'googlevideo.com'

